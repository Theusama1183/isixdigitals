# Public contact details for iSixDigitals.
# This file is committed so the deployed site picks up the same values.
# Anything left empty is hidden -- no placeholder is rendered.

NEXT_PUBLIC_CONTACT_EMAIL=hello@isixdigitals.com
NEXT_PUBLIC_SERVICE_AREA=Lahore, Pakistan

# Optional -- add these when they are ready to be published.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_BOOKING_URL=

# Absolute site URL used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://isixdigitals.com

# Deployment tokens removed from repo; set via CI secrets instead.
