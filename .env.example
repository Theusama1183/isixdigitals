# Contact details shown across the site.
# Copy this file to `.env.local` and fill in what you want to publish.
# Anything left empty is hidden — the site never renders a placeholder.
#
# These values are read on the server during rendering. Public pages are
# statically prerendered, so rebuild (`bun run build`) after changing them.

# Example: hello@isixdigitals.com
NEXT_PUBLIC_CONTACT_EMAIL=

# Example: +92 300 1234567
NEXT_PUBLIC_CONTACT_PHONE=

# Used in the footer, the contact page, and the About page.
# Phrase it as a place, e.g. "Lahore, Pakistan" or "Pakistan & the Gulf".
NEXT_PUBLIC_SERVICE_AREA=

# Optional scheduling link for the "Prefer to book a conversation?" row.
# Example: https://cal.com/isixdigitals/intro
NEXT_PUBLIC_BOOKING_URL=

# Absolute site URL used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://isixdigitals.com
